{
  "name": "peliculas-app",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:dev",
    "build": "npm run build:prod",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "test:coverage": "ng test --watch=false --code-coverage && start ./coverage/peliculas-app/index.html",
    "start:dev": "ng serve --c=development",
    "start:dev:o": "ng serve --c=development -o",
    "build:dev": "ng build --c=development",
    "start:prod": "ng serve --c=production",
    "start:prod:o": "ng serve --c=production -o",
    "build:prod": "ng build --c=production",
    "lint": "ng lint",
    "prepare": "husky install"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^17.0.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@bluehalo/ngx-leaflet": "^18.0.2",
    "flowbite": "^2.5.2",
    "leaflet": "^1.9.4",
    "ng-angular-popup": "^0.6.6",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.15.10",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.8",
    "@angular/cli": "^18.2.8",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.16",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.5.2"
  }
}
